# WorkspaceLab
HOST=127.0.0.1
PORT=8787

# Real Workspace adapter
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
GOOGLE_ADMIN_EMAIL=admin@your-domain.com

# Safety: default dry-run. Set to 0 only after allowlist is verified.
DRY_RUN=1
ALLOWLIST=@your-domain.com

# Optional: Google Chat incoming webhook for the "post_chat" step.
# Create it in the target Chat space: Space settings -> Apps & integrations -> Webhooks.
CHAT_WEBHOOK_URL=
